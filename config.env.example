# OpenLiteSpeed + WordPress Deployment Configuration
# Copy this file and adjust values before running deploy.sh:
#   sudo bash deploy.sh --config config.env

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=example.com

# ── PHP version (lsphp package suffix: 83 = 8.3, 84 = 8.4) ───────────────────
PHP_VERSION=84

# ── SSL via Let's Encrypt ─────────────────────────────────────────────────────
# Set to true only after DNS for DOMAIN points to this server
INSTALL_SSL=false

# ── WordPress admin account ───────────────────────────────────────────────────
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=admin@example.com

# ── WordPress database ────────────────────────────────────────────────────────
WP_DB_NAME=wordpress
WP_DB_USER=wpuser
# Leave blank to auto-generate a secure password
WP_DB_PASS=

# ── MariaDB root password ─────────────────────────────────────────────────────
# Leave blank to auto-generate
MYSQL_ROOT_PASS=

# ── OpenLiteSpeed admin panel ─────────────────────────────────────────────────
OLS_ADMIN_USER=admin
# Leave blank to auto-generate
OLS_ADMIN_PASS=
